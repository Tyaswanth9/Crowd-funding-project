      </column>
      <column caption='weekday_staues' datatype='string' name='[Calculation_1081145442356764676]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='if(datepart(&apos;weekday&apos; , [Calculation_1474928934153416705]) in(1,7)) THEN &quot;weekend&quot;&#13;&#10;else &quot;weekday&quot;&#13;&#10;END' />
      </column>
      <column caption='day_name' datatype='string' name='[Calculation_1081145442357583877]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='datename(&apos;weekday&apos;,[Calculation_1474928934153416705])' />
      </column>
      <column caption='day_number' datatype='integer' name='[Calculation_1081145442360979464]' role='measure' type='quantitative'>
