      </column>
      <column caption='goal_range' datatype='string' name='[Calculation_1081145442382610446]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='if[Calculation_1474928934154817540]&lt;=1000 THEN &apos;0 - 1000&apos;&#13;&#10;ELSEIF [Calculation_1474928934154817540] &gt;1001 AND [Calculation_1474928934154817540] &lt;=2000 THEN &apos;1001 - 2000&apos;&#13;&#10;ELSEIF [Calculation_1474928934154817540] &gt;2001 AND [Calculation_1474928934154817540] &lt;=3000 THEN &apos;2001 - 3000&apos;&#13;&#10;ELSEIF [Calculation_1474928934154817540] &gt;3001 AND [Calculation_1474928934154817540] &lt;=4000 THEN &apos;3001 - 4000&apos;&#13;&#10;ELSEIF [Calculation_1474928934154817540] &gt;4001 AND [Calculation_1474928934154817540] &lt;=4500 THEN &apos;4001 - 4500&apos;&#13;&#10;ELSE &apos;above 45000&apos;&#13;&#10;END' />
      </column>
      <column caption='zero' datatype='integer' name='[Calculation_1088463792998830080]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='0' />
      </column>
      <column caption='created_at_covert_normal_date' datatype='datetime' name='[Calculation_1474928934153416705]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='DATEADD(&apos;second&apos;,[created_at],#1970-01-01#)' />
      </column>
      <column caption='deadline_convert_into_normal_date' datatype='datetime' name='[Calculation_1474928934153900034]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='DATEADD(&apos;second&apos;,[deadline],#1970-01-01#)' />
      </column>
      <column caption='project_during_days' datatype='integer' name='[Calculation_1474928934154366979]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='DATEDIFF(&apos;day&apos;,[Calculation_1474928934153416705],[Calculation_1474928934153900034])' />
      </column>
